rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Shared helpers ────────────────────────────────────────────────────────

    // Look up a user doc by uid to read their `blocked` flag.
    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    // True when the caller's account is not blocked.
    // If the user doc doesn't exist yet (e.g. a brand-new Google sign-in before
    // their document has been written), treat them as not blocked by default.
    function callerIsNotBlocked() {
      return !exists(/databases/$(database)/documents/users/$(request.auth.uid))
        || !userDoc(request.auth.uid).data.get('blocked', false);
    }

    // isAdmin/billedUser live in user-admin-flags/{uid} — a separately-secured
    // doc, readable only by its owner + admins — because users/{uid} itself
    // is readable by any authenticated user (required for registration dedup
    // and the invite/browse pickers) and Firestore has no field-level read
    // ACL to keep those fields private on that doc.
    function adminFlagsDoc(uid) {
      return get(/databases/$(database)/documents/user-admin-flags/$(uid));
    }

    // True when the caller has isAdmin: true — checked on user-admin-flags first,
    // falling back to the legacy users/{uid}.isAdmin field so admin access keeps
    // working uninterrupted regardless of migration order. Once every existing
    // account has been migrated to user-admin-flags and users/{uid}.isAdmin has
    // been stripped (see scripts/migrate-user-admin-flags.mjs), the fallback
    // clause below is dead and can be deleted.
    function callerIsAdmin() {
      return (
        exists(/databases/$(database)/documents/user-admin-flags/$(request.auth.uid))
        && adminFlagsDoc(request.auth.uid).data.get('isAdmin', false) == true
      ) || (
        exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc(request.auth.uid).data.get('isAdmin', false) == true
      );
    }

    // Non-admin clients must not change admin-managed flags on user documents.
    function adminManagedUserFlagsUnchanged() {
      return request.resource.data.get('blocked', false) == resource.data.get('blocked', false)
        && request.resource.data.get('billedUser', false) == resource.data.get('billedUser', false)
        && request.resource.data.get('isAdmin', false) == resource.data.get('isAdmin', false);
    }

    // Self-created user docs may include admin-managed flags only at their safe defaults.
    function validUserCreateFlags() {
      return request.resource.data.get('blocked', false) == false
        && request.resource.data.get('billedUser', false) == false
        && request.resource.data.get('isAdmin', false) == false;
    }

    // True when the named group document exists and is not blocked.
    function groupIsNotBlocked(groupId) {
      return !get(/databases/$(database)/documents/groups/$(groupId)).data.get('blocked', false);
    }

    // Helper: look up a user's Firebase Auth uid from the users collection.
    // Used to enforce owner-only access on personal data collections.
    function ownerUid(mobile) {
      return get(/databases/$(database)/documents/users/$(mobile)).data.uid;
    }

    function groupDoc(groupId) {
      return get(/databases/$(database)/documents/groups/$(groupId));
    }

    function callerIsGroupOwner(groupId) {
      return exists(/databases/$(database)/documents/groups/$(groupId))
        && groupDoc(groupId).data.get('ownerUid', '') == request.auth.uid;
    }

    function callerIsGroupMember(groupId) {
      return exists(/databases/$(database)/documents/groups/$(groupId))
        && groupDoc(groupId).data.get('members', []).hasAny([{ 'uid': request.auth.uid }]);
    }

    function callerIsPendingGroupMember(groupId) {
      return exists(/databases/$(database)/documents/groups/$(groupId))
        && groupDoc(groupId).data.get('pendingMembers', []).hasAny([{ 'uid': request.auth.uid }]);
    }

    // A stranger (not yet a member/owner/pending-invitee/admin) may only touch
    // `joinRequests`, and only to add or withdraw their OWN request — never anyone
    // else's. Firestore rules have no per-element predicate on array fields, so
    // this is expressed as tightly as the language allows: the write may change the
    // list's size by exactly one entry; on an add, every previously-existing entry
    // must survive unchanged and the new (always-appended) entry must carry the
    // caller's own uid; on a withdrawal, every entry left over must have already
    // existed. This blocks wiping or mass-injecting the whole queue in one write;
    // it cannot, on its own, prove a withdrawal removed the caller's own entry
    // specifically rather than a stranger's — closing that fully would require
    // moving `joinRequests` to a subcollection keyed by uid.
    function callerCanModifyOwnJoinRequest(changedKeys) {
      let oldRequests = resource.data.get('joinRequests', []);
      let newRequests = request.resource.data.get('joinRequests', []);
      return changedKeys.hasOnly(['joinRequests'])
        && (
          (newRequests.size() == oldRequests.size() + 1
            && newRequests.hasAll(oldRequests)
            && newRequests[newRequests.size() - 1].uid == request.auth.uid)
          || (newRequests.size() == oldRequests.size() - 1
            && oldRequests.hasAll(newRequests))
        );
    }

    // Zero-`get()` equivalents of groupIsNotBlocked()/callerIsGroupOwner()/
    // callerIsGroupMember()/callerIsPendingGroupMember() for use ONLY where
    // `resource` already IS the group document being written — i.e. inside
    // callerCanWriteGroup()/callerCanDeleteGroup() below, never elsewhere.
    // Those get()-based originals re-fetch the exact same document from
    // scratch every time they're called; doing that repeatedly across a big
    // OR chain of alternatives is what blew Firestore's per-request
    // expression-evaluation budget (a real group update was hitting "maximum
    // of 1000 expressions to evaluate" and failing outright, verified
    // against the emulator, before this fix).
    function selfGroupIsNotBlocked() {
      return !resource.data.get('blocked', false);
    }
    function callerOwnsThisGroup() {
      return resource.data.get('ownerUid', '') == request.auth.uid;
    }
    function callerIsMemberOfThisGroup() {
      return resource.data.get('members', []).hasAny([{ 'uid': request.auth.uid }]);
    }
    function callerIsPendingMemberOfThisGroup() {
      return resource.data.get('pendingMembers', []).hasAny([{ 'uid': request.auth.uid }]);
    }

    // ── Membership & approval-forgery closures ────────────────────────────────
    // Non-owner/admin members used to be able to write ANY group field except
    // name/description/ownerUid — including `members`/`pendingMembers` and
    // every *Request.approvals array — with nothing checking WHAT changed
    // beyond those three names. That let any member (even one only in
    // pendingMembers, not yet accepted) rewrite `members` directly — add an
    // accomplice, evict the owner, wipe the group — and let any member forge
    // a *Request.approvals array with every member's uid in a single write,
    // instantly faking the unanimous consent the app's approval flows are
    // supposed to require before a destructive/data-changing write goes
    // through. The functions below replace that blanket permission with an
    // allow-list of the exact write shapes the app's real flows produce (see
    // groups.js / shared-groups.js / GroupAccessGuard.vue / settlement.js /
    // useApprovalRequests.js) — everything else now falls through to
    // "owner/admin only", failing safe instead of failing open.
    //
    // Approval arrays are plain uid strings, never {uid} objects, precisely
    // so `.toSet()` can dedupe them for unanimity checks. Arrays have no
    // per-element predicate in these rules, but every real write appends at
    // the end, so "the last element is new and it's the caller's own uid,
    // every earlier element is untouched" pins a write down to exactly one
    // addition — and it can only ever be the caller's own real,
    // cryptographically-verified uid, never someone else's. One known,
    // accepted gap: a member could still call the append-mutation several
    // times across SEPARATE writes to accumulate more than one entry
    // crediting themself, so a threshold check is only proof against
    // forgery-in-one-write, not against a single already-participating
    // member padding the count over multiple calls — narrower by orders of
    // magnitude than the original bug, and bounded to members who already
    // have real standing in that specific group.

    function newMembersField() { return request.resource.data.get('members', []); }
    function newPendingField() { return request.resource.data.get('pendingMembers', []); }

    // Every check below used to call request.resource.data.diff(resource.data)
    // itself, computing the same whole-document diff up to ~19 times per
    // write — expensive enough to blow Firestore's 1000-subexpression
    // evaluation budget on a real, only-moderately-sized group document.
    // `changedKeys` is computed once in callerCanWriteGroup() and threaded
    // through every helper below instead.

    // Caller changes their OWN standing in the group in one of three ways —
    // accept a pending invite (pendingMembers → members), decline one
    // (pendingMembers only), or leave voluntarily (members only) — folded
    // into one function (rather than three) since Firestore charges a fixed
    // evaluation-complexity cost per function tried in the big OR chain
    // below, and a real group document blew that budget with one function
    // per pattern. ownerUid may also change here only when the caller
    // currently reads as the group's owner (auto-transfer on leave).
    function callerModifiesOwnMembership(changedKeys) {
      let oldM = resource.data.get('members', []);
      let oldP = resource.data.get('pendingMembers', []);
      let newM = newMembersField();
      let newP = newPendingField();
      let selfUid = [{ 'uid': request.auth.uid }];
      return (
        // accept: self added to members, self removed from pendingMembers
        (changedKeys.hasOnly(['members', 'pendingMembers', 'memberUids', 'notifications'])
          && oldP.hasAny(selfUid) && !newP.hasAny(selfUid)
          && newP.size() == oldP.size() - 1 && oldP.hasAll(newP)
          && newM.size() == oldM.size() + 1 && newM.hasAll(oldM) && newM.hasAny(selfUid))
        // decline: self removed from pendingMembers only
        || (changedKeys.hasOnly(['pendingMembers', 'memberUids', 'notifications'])
          && oldP.hasAny(selfUid) && !newP.hasAny(selfUid)
          && newP.size() == oldP.size() - 1 && oldP.hasAll(newP))
        // leave: self removed from members only (ownerUid may auto-transfer)
        || (changedKeys.hasOnly(['members', 'ownerUid', 'memberUids', 'notifications'])
          && oldM.hasAny(selfUid) && !newM.hasAny(selfUid)
          && newM.size() == oldM.size() - 1 && oldM.hasAll(newM)
          && (!changedKeys.hasAny(['ownerUid']) || callerOwnsThisGroup()))
      );
    }

    // A single new entry was appended to `newList` relative to `oldList`,
    // and it's the caller's own uid — the core primitive every
    // approvals-array check below builds on.
    function approvalAddedByCaller(oldList, newList) {
      return newList.size() == oldList.size() + 1
        && newList.hasAll(oldList)
        && newList[newList.size() - 1] == request.auth.uid;
    }

    // Resolves to whichever ONE of the four group-level *Request fields this
    // write actually touched (or '' if none/more than one) — computed once
    // so the approval-added/created/cleared checks below run their
    // (comparatively expensive) logic against a single resolved field
    // instead of trying all 4 fields × 3 checks = 12 function calls per write.
    function changedRequestField(changedKeys) {
      return changedKeys.hasOnly(['deleteRequest']) ? 'deleteRequest'
        : changedKeys.hasOnly(['editRequest']) ? 'editRequest'
        : changedKeys.hasOnly(['addMemberRequest']) ? 'addMemberRequest'
        : changedKeys.hasOnly(['settlementRequest']) ? 'settlementRequest'
        : '';
    }

    // True when writing `fieldName` (a *Request object living directly on
    // the group doc — deleteRequest / editRequest / addMemberRequest /
    // settlementRequest) only appended the caller's own uid to its
    // `approvals` list, touching no other field.
    function groupRequestApprovalAdded(fieldName) {
      // `let` bindings evaluate eagerly, before the `fieldName != ''` check
      // below ever runs, so .get() always needs a real field name to probe
      // even on the "nothing relevant changed" path — falling back to a
      // fixed, always-valid name here (its value is discarded whenever
      // fieldName is actually '') avoids that call ever seeing '' itself.
      let probeField = fieldName == '' ? 'deleteRequest' : fieldName;
      let oldApprovals = resource.data.get(probeField, {}).get('approvals', []);
      let newApprovals = request.resource.data.get(probeField, {}).get('approvals', []);
      return fieldName != ''
        && approvalAddedByCaller(oldApprovals, newApprovals);
    }

    // A brand-new `fieldName` request was created by the caller, with the
    // caller as requester and the shape's own starting approvals: settlement
    // and addMember requests self-approve on creation, delete and edit don't
    // (see requestGroupDeletion()/updateGroup() vs requestAddMember()/
    // settlement.js's requestSettlement()).
    function groupRequestCreatedByCaller(fieldName) {
      // Same eager-`let` reasoning as groupRequestApprovalAdded() above.
      let probeField = fieldName == '' ? 'deleteRequest' : fieldName;
      let newReq = request.resource.data.get(probeField, {});
      let startingApprovals = (fieldName == 'addMemberRequest' || fieldName == 'settlementRequest')
        ? [request.auth.uid] : [];
      return fieldName != ''
        && !(fieldName in resource.data)
        && newReq.get('requestedBy', '') == request.auth.uid
        && newReq.get('approvals', []) == startingApprovals;
    }

    // `fieldName` existed and was removed entirely (cancel/reject/finalize
    // clearing the request marker) with nothing else changing — any member
    // may do this (matches the app's existing "no owner/uid check" reject
    // flows; low risk since it only discards a pending proposal).
    function groupRequestClearedByAnyMember(fieldName) {
      return fieldName != ''
        && (fieldName in resource.data)
        && !(fieldName in request.resource.data);
    }

    // Only the LAST entry in `joinRequests` may gain an approval via this
    // path — arrays have no per-element predicate, and every real approval
    // targets one arbitrary pending request out of possibly several, so
    // there's no general way here to prove "exactly one arbitrary-position
    // entry changed, nothing else did." Approving anything other than the
    // most-recent pending join request still works, just via the
    // owner/admin fallback instead of this member shortcut.
    function joinRequestApprovalAdded(changedKeys) {
      let oldRequests = resource.data.get('joinRequests', []);
      let newRequests = request.resource.data.get('joinRequests', []);
      return changedKeys.hasOnly(['joinRequests'])
        && oldRequests.size() > 0
        && newRequests.size() == oldRequests.size()
        && newRequests[newRequests.size() - 1].uid == oldRequests[oldRequests.size() - 1].uid
        && approvalAddedByCaller(
             oldRequests[oldRequests.size() - 1].get('approvals', []),
             newRequests[newRequests.size() - 1].get('approvals', [])
           );
    }

    // Finalizes a fully-approved join request: the sole request is removed
    // from joinRequests and its requester is added to members. Only handles
    // the single-pending-request case for the same reason noted above —
    // finalizing while multiple join requests are pending falls back to
    // owner/admin.
    function callerFinalizesJoinRequest(changedKeys) {
      let oldRequests = resource.data.get('joinRequests', []);
      let newRequests = request.resource.data.get('joinRequests', []);
      let oldM = resource.data.get('members', []);
      let newM = newMembersField();
      return changedKeys.hasOnly(['joinRequests', 'members', 'memberUids'])
        && oldRequests.size() == 1
        && newRequests.size() == 0
        && oldRequests[0].get('approvals', []).toSet().size() >= oldM.size()
        && newM.size() == oldM.size() + 1
        && newM.hasAll(oldM)
        && newM.hasAny([{ 'uid': oldRequests[0].uid }]);
    }

    // Finalizes a fully-approved edit request: replaces name/members with
    // exactly what was proposed (never something else) and drops
    // editRequest, once approvals have reached the pre-write member count.
    function callerFinalizesEditRequest(changedKeys) {
      let oldReq = resource.data.get('editRequest', {});
      let oldM = resource.data.get('members', []);
      let newM = newMembersField();
      return changedKeys.hasOnly(['editRequest', 'name', 'members', 'memberUids'])
        && !('editRequest' in request.resource.data)
        && oldReq.get('approvals', []).toSet().size() >= oldM.size()
        && newM == oldReq.get('newMembers', oldM)
        && request.resource.data.get('name', null) == oldReq.get('name', resource.data.get('name', null));
    }

    // Finalizes a fully-approved add-member request: adds exactly the
    // proposed newMember (never something else) and drops addMemberRequest,
    // once approvals have reached the pre-write member count.
    function callerFinalizesAddMemberRequest(changedKeys) {
      let oldReq = resource.data.get('addMemberRequest', {});
      let oldM = resource.data.get('members', []);
      let newM = newMembersField();
      return changedKeys.hasOnly(['addMemberRequest', 'members', 'memberUids'])
        && !('addMemberRequest' in request.resource.data)
        && oldReq.get('approvals', []).toSet().size() >= oldM.size()
        && newM.size() == oldM.size() + 1
        && newM.hasAll(oldM)
        && newM.hasAny([oldReq.get('newMember', {})]);
    }

    function callerCanWriteGroup(groupId) {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      // Resolved once — at most one of these three can ever be true for a
      // given write (a *Request field is either being created, having an
      // approval added, or being cleared, never two of those at once), so
      // this replaces what would otherwise be 3 fields × 4 names = 12
      // separate (and separately costed) function calls with 3.
      let requestField = changedRequestField(changedKeys);
      return request.auth != null
        && callerIsNotBlocked()
        && (selfGroupIsNotBlocked() || callerIsAdmin())
        && (
          callerIsAdmin()
          || callerOwnsThisGroup()
          || callerCanModifyOwnJoinRequest(changedKeys) // a stranger proposing/withdrawing their own join request
          || (
            (callerIsMemberOfThisGroup() || callerIsPendingMemberOfThisGroup())
            && (
              // Mirrors sharedItemRequestMetaOnly()'s treatment of `notifications`
              // on shared-expense/loan items: no sensitive data, so any member may
              // create a notification for a co-member (e.g. "you were renamed") or
              // clear their own (dismissing it) without full-member approval.
              changedKeys.hasOnly(['notifications'])
              || callerModifiesOwnMembership(changedKeys)
              || joinRequestApprovalAdded(changedKeys)
              || callerFinalizesJoinRequest(changedKeys)
              || callerFinalizesEditRequest(changedKeys)
              || callerFinalizesAddMemberRequest(changedKeys)
              || groupRequestApprovalAdded(requestField)
              || groupRequestCreatedByCaller(requestField)
              || groupRequestClearedByAnyMember(requestField)
            )
          )
        );
    }

    function callerCanDeleteGroup(groupId) {
      return request.auth != null
        && callerIsNotBlocked()
        && (
          callerIsAdmin()
          || callerOwnsThisGroup()
          || (
            callerIsMemberOfThisGroup()
            && resource.data.get('deleteRequest', {}).get('requested', false) == true
            // .toSet() dedupes — approvals are plain uid strings — so a
            // padded/duplicated array can't fake reaching the threshold.
            && resource.data.get('deleteRequest', {}).get('approvals', []).toSet().size()
              >= resource.data.get('members', []).size()
          )
        );
    }

    function callerCanAccessSharedGroup(groupId) {
      return request.auth != null
        && callerIsNotBlocked()
        && groupIsNotBlocked(groupId)
        && (callerIsAdmin() || callerIsGroupMember(groupId));
    }

    // True when `data` is a verified mirror of a real shared-expense payment: it
    // links back (sourceGroupId/sourceItemId/sourceMonthYear) to a payments doc
    // in a group the caller can access, and `uid` is genuinely one of its payers.
    // Lets a member cross-post an expense they added into another member's
    // personal-expenses when that member is the one who actually paid — without
    // opening personal-expenses to arbitrary writes from other group members.
    function isValidSharedExpenseMirror(uid, monthYear, data) {
      let sourceItem = get(/databases/$(database)/documents/shared-expenses/$(data.sourceGroupId)/months/$(data.sourceMonthYear)/payments/$(data.sourceItemId)).data;
      return data.sourceMonthYear == monthYear
        && callerCanAccessSharedGroup(data.sourceGroupId)
        && sourceItem.get('payerUids', []).hasAny([uid]);
    }

    // ── Shared-expense/loan item approval enforcement ──────────────────────────
    // Mirrors callerCanDeleteGroup()'s deleteRequest.approvals check, extended to
    // per-item update/delete requests and to settlement finalization. Requires
    // useApprovalRequests.js's executeRequest() to apply the change/delete in the
    // SAME write that would otherwise clear the request field — see its comment.

    function sharedItemMemberCount(groupId) {
      return groupDoc(groupId).data.get('members', []).size();
    }

    // .toSet() dedupes the approvals array so a member can't inflate the count
    // by pushing duplicate/forged uids into it in a single write.
    function sharedItemRequestApproved(fieldName, groupId) {
      return resource.data.get(fieldName, {}).get('approvals', []).toSet().size()
        >= sharedItemMemberCount(groupId);
    }

    function sharedItemSettlementApproved(groupId) {
      return groupDoc(groupId).data.get('settlementRequest', {}).get('approvals', []).toSet().size()
        >= sharedItemMemberCount(groupId);
    }

    // Validates one transition of `fieldName` (deleteRequest/updateRequest on
    // a payment/loan item): created fresh by the caller (self-approved from
    // the start, matching buildRequestMeta.js), cleared entirely
    // (cancel/reject), or had exactly the caller's own uid appended to its
    // approvals — never an arbitrary full-array replace. Closes the same
    // forgery hole as groupRequestApprovalAdded() above, for item-level
    // requests specifically (whose approvals were already plain uid strings).
    function sharedItemRequestValid(fieldName) {
      let oldReq = resource.data.get(fieldName, {});
      let newReq = request.resource.data.get(fieldName, {});
      return (!(fieldName in resource.data) && (fieldName in request.resource.data)
                && newReq.get('requestedBy', '') == request.auth.uid
                && newReq.get('approvals', []) == [request.auth.uid])
        || ((fieldName in resource.data) && !(fieldName in request.resource.data))
        || ((fieldName in resource.data) && (fieldName in request.resource.data)
              && approvalAddedByCaller(oldReq.get('approvals', []), newReq.get('approvals', [])));
    }

    // Members may always propose/approve/cancel/reject a request or clear their
    // own notification — narrowly scoped the same way callerCanModifyOwnJoinRequest()
    // restricts join-request writes to just the joinRequests field, and now also
    // validates *what* changed on deleteRequest/updateRequest, not just that only
    // those keys changed (see sharedItemRequestValid()).
    function sharedItemRequestMetaOnly() {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return changedKeys.hasOnly(['deleteRequest', 'updateRequest', 'notifications'])
        && (!changedKeys.hasAny(['deleteRequest']) || sharedItemRequestValid('deleteRequest'))
        && (!changedKeys.hasAny(['updateRequest']) || sharedItemRequestValid('updateRequest'));
    }

    // Users — any authenticated user can read.
    // New users may create their own document (callerIsNotBlocked() would fail because
    // the document doesn't exist yet when checked). Updates/deletes still require the
    // caller not to be blocked. Admin-managed flags on users/{uid} remain writable
    // only by admins.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && validUserCreateFlags();
      allow update: if request.auth != null
                    && callerIsNotBlocked()
                    && (
                      callerIsAdmin()
                      || (
                        request.auth.uid == userId
                        && request.resource.data.get('uid', userId) == resource.data.get('uid', userId)
                        && adminManagedUserFlagsUnchanged()
                      )
                    );
      allow delete: if request.auth != null
                    && callerIsNotBlocked()
                    && (request.auth.uid == userId || callerIsAdmin());
    }

    // User tab configs — owner can read/write their own tab flags.
    // A blocked user may still update their own config (e.g. hide-blocked toggle)
    // but must not change `accessManageTabs`.
    // Admins may write any tab-config field to any user's config.
    match /user-tab-configs/{uid} {
      allow read: if request.auth != null
                  && (request.auth.uid == uid || callerIsAdmin());
      allow create: if (request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.uid == uid
                    && !('accessManageTabs' in request.resource.data))
                    || callerIsAdmin();
      allow update: if callerIsAdmin()
                    || (request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.uid == uid
                    && (
                      !('accessManageTabs' in request.resource.data)
                      || (
                        'accessManageTabs' in resource.data
                        && request.resource.data.accessManageTabs == resource.data.accessManageTabs
                      )
                    ));
      allow delete: if false;
    }

    // Admin-only user flags — split out of users/{uid} because that doc is
    // readable by any authenticated user. Only the owner may read their own
    // flags (to gate their own UI); only admins may write, matching how these
    // three fields were already admin-managed on the old users/{uid} location.
    match /user-admin-flags/{uid} {
      allow read: if request.auth != null
                  && (request.auth.uid == uid || callerIsAdmin());
      allow write: if request.auth != null && callerIsAdmin();
    }

    // Private user fields (currently just email) — split out of users/{uid} for
    // the same reason as user-admin-flags: that doc is readable by any
    // authenticated user, and Firestore has no field-level read ACL. Unlike
    // admin flags, the owner may write their own (email is set once at
    // registration; a future "change email" flow would write here too).
    // mobile deliberately stays on users/{uid} — it's a functional identifier
    // used across group invites, split-matching, etc., not just PII; splitting
    // it out is a larger follow-up, not done here.
    match /user-private/{uid} {
      allow read: if request.auth != null
                  && (request.auth.uid == uid || callerIsAdmin());
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null
                    && (request.auth.uid == uid || callerIsAdmin());
      allow delete: if false;
    }

    // Groups — any authenticated user can read (required for the "browse/join
    // other groups" flow and for shared-group links, both of which must resolve
    // groups the caller is not yet a member of; Firestore has no field-level read
    // ACL, so this necessarily also exposes member/pending/join-request uids on
    // groups the caller has never touched — an accepted tradeoff of that feature).
    // Writes require:  (a) caller is not blocked, AND (b) the group is not blocked,
    // with callerIsAdmin() short-circuiting both for moderation actions (e.g.
    // setting `blocked`) since admin accounts are never blocked themselves.
    // Create is locked to the creator's own uid as owner and sole initial member —
    // matching the app's actual create flow (only the creator joins immediately;
    // everyone else lands in `pendingMembers` as an invite) — so no one can forge
    // group ownership or force another uid straight into `members` without consent.
    match /groups/{groupId} {
      allow read: if request.auth != null;
      // create: group doesn't exist yet — groupIsNotBlocked() would fail on get() of missing doc.
      allow create: if request.auth != null
                    && callerIsNotBlocked()
                    && request.resource.data.get('ownerUid', '') == request.auth.uid
                    && request.resource.data.get('members', []) == [{ 'uid': request.auth.uid }];
      allow update: if callerCanWriteGroup(groupId);
      allow delete: if callerCanDeleteGroup(groupId);
    }
    // No subcollections live under groups/{groupId} anywhere in the app (all group
    // data is a single document) — no rule is declared for them, so they default
    // to fully denied rather than staying open dead attack surface.

    // Shared expenses — blocked user cannot write; writes into a blocked group are denied.
    // Payment items require full-member approval (or a fully-approved settlement)
    // before a destructive/data-changing write goes through — see the
    // sharedItem*() helpers above. Everything else under a group (the month doc
    // itself, request/notification bookkeeping) stays member-writable as before.
    match /shared-expenses/{groupId} {
      allow read, write: if callerCanAccessSharedGroup(groupId);
    }
    match /shared-expenses/{groupId}/months/{monthYear} {
      allow read, write: if callerCanAccessSharedGroup(groupId);
    }
    match /shared-expenses/{groupId}/months/{monthYear}/payments/{itemId} {
      allow read, create: if callerCanAccessSharedGroup(groupId);
      allow update: if callerCanAccessSharedGroup(groupId)
                    && (
                      sharedItemRequestMetaOnly()
                      || sharedItemRequestApproved('updateRequest', groupId)
                    );
      allow delete: if callerCanAccessSharedGroup(groupId)
                    && (
                      sharedItemRequestApproved('deleteRequest', groupId)
                      || sharedItemSettlementApproved(groupId)
                    );
    }

    // Shared expenses backup — non-destructive archival copies (settlement
    // finalize writes here before deleting the source); no approval gating needed.
    match /shared-expenses-backup/{groupId} {
      allow read, write: if callerCanAccessSharedGroup(groupId);
    }
    match /shared-expenses-backup/{groupId}/{document=**} {
      allow read, write: if callerCanAccessSharedGroup(groupId);
    }

    // Shared loans — same approval-gated shape as shared-expenses above.
    match /shared-loans/{groupId} {
      allow read, write: if callerCanAccessSharedGroup(groupId);
    }
    match /shared-loans/{groupId}/months/{monthYear} {
      allow read, write: if callerCanAccessSharedGroup(groupId);
    }
    match /shared-loans/{groupId}/months/{monthYear}/loans/{itemId} {
      allow read, create: if callerCanAccessSharedGroup(groupId);
      allow update: if callerCanAccessSharedGroup(groupId)
                    && (
                      sharedItemRequestMetaOnly()
                      || sharedItemRequestApproved('updateRequest', groupId)
                    );
      allow delete: if callerCanAccessSharedGroup(groupId)
                    && (
                      sharedItemRequestApproved('deleteRequest', groupId)
                      || sharedItemSettlementApproved(groupId)
                    );
    }

    // Personal expenses — read restricted to owner; blocked user cannot write
    match /personal-expenses/{mobile} {
      allow read: if request.auth != null && request.auth.uid == ownerUid(mobile);
      allow write: if request.auth != null
                   && request.auth.uid == ownerUid(mobile)
                   && callerIsNotBlocked();
    }
    match /personal-expenses/{mobile}/{document=**} {
      allow read: if request.auth != null && request.auth.uid == ownerUid(mobile);
      allow write: if request.auth != null
                   && request.auth.uid == ownerUid(mobile)
                   && callerIsNotBlocked();
    }

    // Non-owner create allowed only for a verified shared-expense mirror (see
    // isValidSharedExpenseMirror) — covers "I added a shared expense that
    // someone else paid".
    match /personal-expenses/{uid}/months/{monthYear}/expenses/{expenseId} {
      allow create: if request.auth != null
                    && callerIsNotBlocked()
                    && isValidSharedExpenseMirror(uid, monthYear, request.resource.data);
    }

    // Bookkeeping only — no real data — for the same cross-post. Lets a
    // non-owner touch just the `months` index (root doc) or create/refresh an
    // always-empty month marker doc; neither ever holds sensitive content.
    match /personal-expenses/{uid} {
      // A payer with no prior personal-expenses doc makes this a *create*
      // (setDoc(..., {merge:true}) on a non-existent doc), not an update —
      // resource.data doesn't exist yet to diff against, so this needs its
      // own branch rather than falling through to the update rule below.
      allow create: if request.auth != null
                    && callerIsNotBlocked()
                    && request.resource.data.keys().hasOnly(['months']);
      allow update: if request.auth != null
                    && callerIsNotBlocked()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['months']);
    }
    match /personal-expenses/{uid}/months/{monthYear} {
      allow create, update: if request.auth != null
                    && callerIsNotBlocked()
                    && request.resource.data.size() == 0;
    }

    // Personal loans — owner only; blocked user cannot write
    match /personal-loans/{mobile} {
      allow read, write: if request.auth != null
                         && request.auth.uid == ownerUid(mobile)
                         && callerIsNotBlocked();
    }
    match /personal-loans/{mobile}/{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == ownerUid(mobile)
                         && callerIsNotBlocked();
    }

    // Salaries — owner only; blocked user cannot write
    match /salaries/{mobile}/{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == ownerUid(mobile)
                         && callerIsNotBlocked();
    }

    // Collection group rules for leave-group balance checks
    match /{path=**}/payments/{paymentId} {
      allow read: if request.auth != null
                  && (callerIsAdmin() || callerIsGroupMember(resource.data.get('group', '')));
    }
    match /{path=**}/loans/{loanId} {
      allow read: if request.auth != null
                  && (callerIsAdmin() || callerIsGroupMember(resource.data.get('group', '')));
    }

    // App config — readable by any authenticated user; writable only by admins
    match /configs/{configId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && callerIsAdmin();
    }
  }
}
